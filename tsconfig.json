{
  "compilerOptions": {
    "resolveJsonModule": true,
    "isolatedModules": true,
    "target": "ES2022",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "lib": ["ES2022", "DOM"],
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
  },
  "files": [
    "src/ReelDeal.ts",
    "src/defaults.ts",
    "src/index.ts",
    "src/normalize.ts",
    "src/types.ts",
    "src/utils/dom.ts",
    "src/utils/math.ts",
    "src/assets/spriteLoader.ts",
    "src/core/loop.ts",
    "src/render/webglRenderer.ts",
    "src/render/lineRenderer.ts",
    "src/render/shaders.ts",
    "src/core/animation.ts",
    "src/core/spinQueue.ts",
    "src/core/uiControls.ts",
    "vite-env.d.ts",
    "vite.config.ts"
  ],
  "include": ["src/**/*.ts", "vite-env.d.ts", "vite.config.ts"]
}
